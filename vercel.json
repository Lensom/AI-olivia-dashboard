{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "back": {
      "root": "back",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    },
    "front": {
      "root": "front",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "back"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "front"
      }
    }
  ]
}
