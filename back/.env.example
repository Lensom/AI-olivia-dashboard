APP_NAME="Olivia API"
APP_VERSION="0.1.0"
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"
AUTH_TOKEN_SECRET="change-me-please"
AUTH_TOKEN_TTL_SECONDS="604800"
# New accounts are refused unless this is true. Turn it on to create your account, then turn it off.
# ALLOW_REGISTRATION=true
CORS_ORIGINS="http://localhost:3000"
# Investing → Watchlist "Analyze" (Google Gemini). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: first model to try, then the comma-separated fallbacks in order when one can't be reached.
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash,gemini-flash-lite-latest
# Investing → sync with Freedom24 (Tradernet API): create a key pair at https://freedom24.com/tradernet-api/auth-api
# The app only ever reads with it (positions, trades, reports); trading commands are blocked in app/broker/freedom24.py.
FREEDOM24_PUBLIC_KEY=
FREEDOM24_PRIVATE_KEY=
# Login email of the only app account allowed to see this Freedom24 portfolio (others get 403).
FREEDOM24_OWNER_EMAIL=
