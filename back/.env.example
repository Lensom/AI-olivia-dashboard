APP_NAME="Olivia API"
APP_VERSION="0.1.0"
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"
AUTH_TOKEN_SECRET="change-me-please"
AUTH_TOKEN_TTL_SECONDS="604800"
CORS_ORIGINS="http://localhost:3000"
# Investing → Watchlist "Analyze" (Google Gemini). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: first model to try, then the comma-separated fallbacks in order when one can't be reached.
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash,gemini-flash-lite-latest
